SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=tcc_hospital
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Envio de e-mail (recuperação de senha) — relay SMTP da Brevo.
# Crie uma conta gratuita em https://app.brevo.com e gere a chave SMTP em
# Configurações > SMTP e API > SMTP.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-login-smtp-brevo
EMAIL_HOST_PASSWORD=sua-chave-smtp-brevo
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Chamados de TI <no-reply@hospital.local>

# Classificador de IA (mDeBERTa zero-shot) — serviço da pasta classificador/.
# Deixe vazio para rodar o sistema sem a classificação automática.
IA_CLASSIFICADOR_URL=http://localhost:8001/classificar
IA_CLASSIFICADOR_TIMEOUT=30
